{
  "schemaVersion": 1,
  "id": "bpvaddon",
  "version": "${version}",
  "name": "Bloomery Voice Visualizer",
  "description": "Client-side configurable voice proximity visualization for Plasmo Voice.",
  "authors": [
    "Bloomery Network Team",
    "xPintoKunG_Z"
  ],
  "contact": {
